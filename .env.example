# PostgreSQL (Docker Compose)
POSTGRES_DB=ms_auth
POSTGRES_USER=ms_auth_user
POSTGRES_PASSWORD=ms_auth_pass

# Conexión MS-Auth -> PostgreSQL (no es el puerto HTTP del microservicio)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=ms_auth
DB_USER=ms_auth_user
DB_PASSWORD=ms_auth_pass

AUTH_SEED_ENABLED=false
AUTH_SEED_ADMIN_PASSWORD=
AUTH_SEED_RECEPTIONIST_PASSWORD=
AUTH_SEED_OPHTHALMOLOGIST_PASSWORD=
